<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>CADabra Face Analysis Viewer</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            width: 100%;
            height: 100vh;
            overflow: hidden;
            background: #1a1a1a;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            cursor: crosshair;
        }
        #container {
            width: 100%;
            height: 100%;
            position: relative;
        }
        #loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #ccc;
            font-size: 14px;
            text-align: center;
            z-index: 10;
        }
        #error {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #ff6b6b;
            font-size: 14px;
            text-align: center;
            z-index: 10;
            max-width: 80%;
            display: none;
        }
        #controls {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(10px);
            padding: 8px;
            border-radius: 6px;
            z-index: 5;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .control-btn {
            background: rgba(74, 158, 255, 0.2);
            border: 1px solid rgba(74, 158, 255, 0.5);
            color: #4a9eff;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            transition: all 0.2s;
        }
        .control-btn:hover {
            background: rgba(74, 158, 255, 0.3);
            border-color: #4a9eff;
        }
        .control-btn.active {
            background: rgba(74, 158, 255, 0.5);
            border-color: #4a9eff;
        }
        #selectionInfo {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(10px);
            padding: 10px 14px;
            border-radius: 6px;
            color: #ffa500;
            font-size: 13px;
            font-weight: bold;
            z-index: 5;
            display: none;
            border: 2px solid #ffa500;
        }
    </style>
</head>
<body>
    <div id="container"></div>
    <div id="loading">Initializing OpenCascade.js viewer...</div>
    <div id="error"></div>
    <div id="controls">
        <button class="control-btn" onclick="resetView()">Reset View</button>
        <button class="control-btn" onclick="fitView()">Fit to View</button>
        <button class="control-btn" id="wireframeBtn" onclick="toggleWireframe()">Wireframe</button>
        <button class="control-btn active" id="edgesBtn" onclick="toggleEdges()">Show Edges</button>
    </div>
    <div id="selectionInfo">No face selected</div>

    <script src="/extensions/ComfyUI-CADabra/.libs/three/three.min.js"></script>
    <script src="/extensions/ComfyUI-CADabra/.libs/three/OrbitControls.js"></script>

    <script type="module">
        import opencascadeInit from '/extensions/ComfyUI-CADabra/.libs/opencascade/opencascade.wasm.js';

        let oc = null;
        let scene, camera, renderer, controls;
        let currentMesh = null;
        let currentEdges = null;
        let container;
        let analysisData = null;
        let faceGeometries = []; // Store per-face geometries for selection
        let selectedFaceIndex = null;
        let highlightMesh = null;
        let highlightEdges = null;
        let raycaster = new THREE.Raycaster();
        let mouse = new THREE.Vector2();

        // Initialize scene
        function initScene() {
            container = document.getElementById('container');
            const width = container.clientWidth;
            const height = container.clientHeight;

            // Scene
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x1a1a1a);

            // Camera
            camera = new THREE.PerspectiveCamera(50, width / height, 0.01, 10000);
            camera.position.set(100, 100, 100);

            // Renderer
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(width, height);
            renderer.setPixelRatio(window.devicePixelRatio);
            container.appendChild(renderer.domElement);

            // Controls
            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.05;
            controls.screenSpacePanning = true;

            // Lights
            const ambientLight = new THREE.AmbientLight(0x404040, 2);
            scene.add(ambientLight);

            const directionalLight1 = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight1.position.set(100, 100, 100);
            scene.add(directionalLight1);

            const directionalLight2 = new THREE.DirectionalLight(0xffffff, 0.4);
            directionalLight2.position.set(-100, 100, -100);
            scene.add(directionalLight2);

            // Add click listener for face selection
            renderer.domElement.addEventListener('click', onMouseClick, false);

            // Window resize
            window.addEventListener('resize', onWindowResize, false);

            // Animation loop
            animate();
        }

        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            renderer.render(scene, camera);
        }

        function onWindowResize() {
            const width = container.clientWidth;
            const height = container.clientHeight;
            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            renderer.setSize(width, height);
        }

        function onMouseClick(event) {
            if (!currentMesh || !analysisData) return;

            // Calculate mouse position in normalized device coordinates
            const rect = renderer.domElement.getBoundingClientRect();
            mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
            mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

            // Raycast
            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObject(currentMesh);

            if (intersects.length > 0) {
                const intersection = intersects[0];
                const faceIndex = intersection.faceIndex;

                // Map triangle index to our face ID
                const selectedFace = findFaceFromTriangle(faceIndex);

                if (selectedFace !== null) {
                    selectFace(selectedFace);
                }
            } else {
                // Clicked on empty space - deselect
                deselectFace();
            }
        }

        function findFaceFromTriangle(triangleIndex) {
            // Each face has a range of triangles
            // We stored this mapping when creating the geometry
            for (let i = 0; i < faceGeometries.length; i++) {
                const faceGeom = faceGeometries[i];
                if (triangleIndex >= faceGeom.triangleStart && triangleIndex < faceGeom.triangleEnd) {
                    return i;
                }
            }
            return null;
        }

        function selectFace(faceId) {
            selectedFaceIndex = faceId;

            // Remove old highlight
            if (highlightMesh) {
                scene.remove(highlightMesh);
                highlightMesh = null;
            }
            if (highlightEdges) {
                scene.remove(highlightEdges);
                highlightEdges = null;
            }

            // Get face geometry
            const faceGeom = faceGeometries[faceId];
            if (!faceGeom || !faceGeom.geometry) return;

            // Create highlight mesh (colored + outline)
            const highlightGeometry = faceGeom.geometry.clone();

            // Face material (semi-transparent orange)
            const faceMaterial = new THREE.MeshPhongMaterial({
                color: 0xffa500,
                transparent: true,
                opacity: 0.7,
                side: THREE.DoubleSide,
                polygonOffset: true,
                polygonOffsetFactor: -1,
                polygonOffsetUnits: -1
            });

            highlightMesh = new THREE.Mesh(highlightGeometry, faceMaterial);
            scene.add(highlightMesh);

            // Thick outline
            const edgesGeometry = new THREE.EdgesGeometry(highlightGeometry, 15);
            const edgesMaterial = new THREE.LineBasicMaterial({
                color: 0xffa500,
                linewidth: 3 // Note: linewidth > 1 only works with WebGLRenderer on some platforms
            });
            highlightEdges = new THREE.LineSegments(edgesGeometry, edgesMaterial);
            scene.add(highlightEdges);

            // Update selection info display
            const selectionInfo = document.getElementById('selectionInfo');
            selectionInfo.style.display = 'block';
            selectionInfo.textContent = `Selected: Face #${faceId}`;

            // Send face data to parent
            const faceData = analysisData.faces[faceId];
            window.parent.postMessage({
                type: "FACE_SELECTED",
                faceData: faceData,
                nodeId: null // Will be set by parent if needed
            }, "*");
        }

        function deselectFace() {
            selectedFaceIndex = null;

            // Remove highlight
            if (highlightMesh) {
                scene.remove(highlightMesh);
                highlightMesh = null;
            }
            if (highlightEdges) {
                scene.remove(highlightEdges);
                highlightEdges = null;
            }

            // Hide selection info
            const selectionInfo = document.getElementById('selectionInfo');
            selectionInfo.style.display = 'none';

            // Notify parent
            window.parent.postMessage({
                type: "FACE_SELECTED",
                faceData: null,
                nodeId: null
            }, "*");
        }

        // Control functions (exposed globally)
        window.resetView = function() {
            camera.position.set(100, 100, 100);
            camera.lookAt(0, 0, 0);
            controls.target.set(0, 0, 0);
            controls.update();
        };

        window.fitView = function() {
            if (!currentMesh) return;

            const box = new THREE.Box3().setFromObject(currentMesh);
            const center = box.getCenter(new THREE.Vector3());
            const size = box.getSize(new THREE.Vector3());

            const maxDim = Math.max(size.x, size.y, size.z);
            const fov = camera.fov * (Math.PI / 180);
            let cameraZ = Math.abs(maxDim / 2 / Math.tan(fov / 2));
            cameraZ *= 1.5; // Zoom out a bit

            camera.position.set(center.x + cameraZ, center.y + cameraZ, center.z + cameraZ);
            camera.lookAt(center);
            controls.target.copy(center);
            controls.update();
        };

        window.toggleWireframe = function() {
            if (!currentMesh) return;
            currentMesh.material.wireframe = !currentMesh.material.wireframe;
            const btn = document.getElementById('wireframeBtn');
            btn.classList.toggle('active');
        };

        window.toggleEdges = function() {
            if (!currentEdges) return;
            currentEdges.visible = !currentEdges.visible;
            const btn = document.getElementById('edgesBtn');
            btn.classList.toggle('active');
        };

        // Load OpenCascade.js
        async function initOpenCascade() {
            const loadingDiv = document.getElementById('loading');
            loadingDiv.textContent = 'Loading OpenCascade.js...';

            try {
                oc = await opencascadeInit({
                    locateFile: (path) => {
                        if (path.endsWith('.wasm')) {
                            return '/extensions/ComfyUI-CADabra/.libs/opencascade/' + path;
                        }
                        return path;
                    }
                });

                console.log('[CADabra Analysis] OpenCascade.js initialized');
                loadingDiv.textContent = 'Waiting for CAD file...';
            } catch (error) {
                console.error('[CADabra Analysis] Failed to initialize OpenCascade.js:', error);
                showError('Failed to initialize OpenCascade.js: ' + error.message);
            }
        }

        // Load CAD file and analysis data
        async function loadCAD(stepUrl, analysisUrl, linearDeflection) {
            if (!oc) {
                console.error('[CADabra Analysis] OpenCascade.js not initialized');
                return;
            }

            const loadingDiv = document.getElementById('loading');
            loadingDiv.textContent = 'Loading CAD file...';

            try {
                // Load STEP file (using same method as working viewer)
                console.log('[CADabra Analysis] Fetching STEP file from:', stepUrl);
                const stepResponse = await fetch(stepUrl);
                if (!stepResponse.ok) {
                    throw new Error(`Failed to fetch STEP file: ${stepResponse.statusText}`);
                }

                // Use same fetching approach as viewer_occ.html
                const stepArrayBuffer = await stepResponse.arrayBuffer();
                const stepFileBuffer = new Uint8Array(stepArrayBuffer);

                // Use a unique filename to avoid conflicts
                const timestamp = Date.now();
                const stepFilename = `model_${timestamp}.step`;
                console.log('[CADabra Analysis] STEP file loaded, size:', stepFileBuffer.length, 'bytes');

                // Write to OpenCascade virtual filesystem
                oc.FS.writeFile('/' + stepFilename, stepFileBuffer);

                // Load analysis data
                loadingDiv.textContent = 'Loading analysis data...';
                const analysisResponse = await fetch(analysisUrl);
                if (!analysisResponse.ok) {
                    throw new Error(`Failed to fetch analysis file: ${analysisResponse.statusText}`);
                }

                analysisData = await analysisResponse.json();
                console.log('[CADabra Analysis] Loaded analysis data:', analysisData);

                // Parse STEP file
                loadingDiv.textContent = 'Parsing CAD geometry...';
                // Parse STEP file - use exact same pattern as viewer_occ.html
                console.log('[CADabra Analysis] Reading STEP file...');
                const reader = new oc.STEPControl_Reader_1();
                const readStatus = reader.ReadFile('/' + stepFilename);

                if (readStatus !== oc.IFSelect_ReturnStatus.IFSelect_RetDone) {
                    console.error('[CADabra Analysis] ReadFile failed. Status:', readStatus, 'Expected:', oc.IFSelect_ReturnStatus.IFSelect_RetDone);
                    throw new Error('Failed to read STEP file');
                }

                console.log('[CADabra Analysis] Transferring to document...');

                console.log('[CADabra Analysis] Checking number of roots...');
                const nbRoots = reader.NbRootsForTransfer();
                console.log('[CADabra Analysis] Number of roots for transfer:', nbRoots);

                console.log('[CADabra Analysis] Transferring roots...');
                const transferResult = reader.TransferRoots();
                console.log('[CADabra Analysis] TransferRoots returned:', transferResult);

                console.log('[CADabra Analysis] Getting shape...');
                const shape = reader.OneShape();
                console.log('[CADabra Analysis] Shape obtained:', shape);
                console.log('[CADabra Analysis] Shape IsNull():', shape.IsNull());

                // Check if shape is valid before using it
                if (shape.IsNull()) {
                    console.error('[CADabra Analysis] Shape is null! Possible reasons:');
                    console.error('  - TransferRoots did not transfer any geometry');
                    console.error('  - Number of roots was:', nbRoots);
                    console.error('  - TransferRoots result was:', transferResult);
                    throw new Error('Failed to extract shape from STEP file - shape is null');
                }

                console.log('[CADabra Analysis] Shape type:', shape.ShapeType());

                // Tessellate
                loadingDiv.textContent = 'Tessellating geometry...';
                console.log('[CADabra Analysis] Creating incremental mesh with deflection:', linearDeflection);
                const incrementalMesh = new oc.BRepMesh_IncrementalMesh_2(
                    shape,
                    linearDeflection,
                    false,
                    0.5, // Angular deflection
                    true
                );
                console.log('[CADabra Analysis] Mesh created:', incrementalMesh);
                console.log('[CADabra Analysis] Mesh IsDone?:', incrementalMesh.IsDone());

                // Extract faces
                loadingDiv.textContent = 'Extracting faces...';
                console.log('[CADabra Analysis] Creating explorer for faces...');
                const explorer = new oc.TopExp_Explorer_2(
                    shape,
                    oc.TopAbs_ShapeEnum.TopAbs_FACE,
                    oc.TopAbs_ShapeEnum.TopAbs_SHAPE
                );

                const vertices = [];
                const indices = [];
                faceGeometries = [];
                let faceIndex = 0;

                console.log('[CADabra Analysis] Starting face iteration...');
                while (explorer.More()) {
                    console.log('[CADabra Analysis] Processing face', faceIndex);
                    const face = oc.TopoDS.Face_1(explorer.Current());
                    const location = new oc.TopLoc_Location_1();
                    const triangulation = oc.BRep_Tool.Triangulation(face, location);
                    console.log('[CADabra Analysis] Face', faceIndex, 'triangulation is null?:', triangulation.IsNull());

                    if (!triangulation.IsNull()) {
                        const transform = location.Transformation();
                        const triangleCount = triangulation.get().NbTriangles();
                        const nodeCount = triangulation.get().NbNodes();

                        // Get face orientation
                        const orientation = face.Orientation_1();
                        const isReversed = (orientation === oc.TopAbs_Orientation.TopAbs_REVERSED);

                        // Store starting indices for this face
                        const vertexStart = vertices.length / 3;
                        const triangleStart = indices.length / 3;

                        // Extract vertices
                        for (let i = 1; i <= nodeCount; i++) {
                            const node = triangulation.get().Node(i);
                            const transformed = node.Transformed(transform);
                            vertices.push(transformed.X(), transformed.Y(), transformed.Z());
                        }

                        // Extract triangles
                        for (let i = 1; i <= triangleCount; i++) {
                            const triangle = triangulation.get().Triangle(i);
                            let i1 = triangle.Value(1) - 1;
                            let i2 = triangle.Value(2) - 1;
                            let i3 = triangle.Value(3) - 1;

                            // Adjust for face orientation
                            if (isReversed) {
                                indices.push(
                                    vertexStart + i1,
                                    vertexStart + i3,
                                    vertexStart + i2
                                );
                            } else {
                                indices.push(
                                    vertexStart + i1,
                                    vertexStart + i2,
                                    vertexStart + i3
                                );
                            }
                        }

                        const triangleEnd = indices.length / 3;

                        // Create individual face geometry for selection
                        const faceVertices = vertices.slice(vertexStart * 3);
                        const faceIndices = [];
                        for (let i = triangleStart * 3; i < triangleEnd * 3; i++) {
                            faceIndices.push(indices[i] - vertexStart);
                        }

                        const faceGeometry = new THREE.BufferGeometry();
                        faceGeometry.setAttribute('position', new THREE.Float32BufferAttribute(faceVertices, 3));
                        faceGeometry.setIndex(faceIndices);
                        faceGeometry.computeVertexNormals();

                        // Store face geometry with triangle range
                        faceGeometries.push({
                            faceId: faceIndex,
                            geometry: faceGeometry,
                            triangleStart: triangleStart,
                            triangleEnd: triangleEnd,
                            vertexStart: vertexStart,
                            vertexEnd: vertices.length / 3
                        });

                        faceIndex++;
                    }

                    explorer.Next();
                }

                console.log('[CADabra Analysis] Face extraction complete. Total faces:', faceIndex);
                console.log('[CADabra Analysis] Total vertices:', vertices.length / 3);
                console.log('[CADabra Analysis] Total triangles:', indices.length / 3);
                console.log('[CADabra Analysis] faceGeometries array length:', faceGeometries.length);

                // Create main mesh
                loadingDiv.textContent = 'Creating 3D mesh...';
                const geometry = new THREE.BufferGeometry();
                geometry.setAttribute('position', new THREE.Float32BufferAttribute(vertices, 3));
                geometry.setIndex(indices);
                geometry.computeVertexNormals();

                const material = new THREE.MeshPhongMaterial({
                    color: 0x88ccff,
                    side: THREE.DoubleSide,
                    polygonOffset: true,
                    polygonOffsetFactor: 1,
                    polygonOffsetUnits: 1
                });

                // Remove old mesh if exists
                if (currentMesh) {
                    scene.remove(currentMesh);
                }
                if (currentEdges) {
                    scene.remove(currentEdges);
                }

                currentMesh = new THREE.Mesh(geometry, material);
                scene.add(currentMesh);

                // Add edges
                const edgesGeometry = new THREE.EdgesGeometry(geometry, 15);
                const edgesMaterial = new THREE.LineBasicMaterial({ color: 0x000000, linewidth: 1 });
                currentEdges = new THREE.LineSegments(edgesGeometry, edgesMaterial);
                scene.add(currentEdges);

                // Fit view
                fitView();

                // Clean up
                oc.FS.unlink('/' + stepFilename);

                loadingDiv.style.display = 'none';
                console.log(`[CADabra Analysis] Loaded ${faceIndex} faces`);

            } catch (error) {
                console.error('[CADabra Analysis] Error loading CAD:', error);
                console.error('[CADabra Analysis] Error stack:', error.stack);
                console.error('[CADabra Analysis] Error name:', error.name);
                console.error('[CADabra Analysis] Error message:', error.message);
                showError('Error loading CAD: ' + error.message);
            }
        }

        function showError(message) {
            const errorDiv = document.getElementById('error');
            const loadingDiv = document.getElementById('loading');
            loadingDiv.style.display = 'none';
            errorDiv.textContent = message;
            errorDiv.style.display = 'block';
        }

        // Listen for messages from parent
        window.addEventListener('message', async (event) => {
            if (event.data.type === 'LOAD_CAD_ANALYSIS') {
                const { stepUrl, analysisUrl, linearDeflection } = event.data;
                await loadCAD(stepUrl, analysisUrl, linearDeflection || 0.1);
            } else if (event.data.type === 'DESELECT_FACE') {
                deselectFace();
            }
        });

        // Initialize
        initScene();
        initOpenCascade();
    </script>
</body>
</html>
